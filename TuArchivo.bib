@article{Barzegari2022Resilient,
  title     = {Resilient Consensus Control Design for DC Microgrids against False Data Injection Attacks Using a Distributed Bank of Sliding Mode Observers},
  author    = {Barzegari, Yousof and Zarei, Jafar and Razavi-Far, Roozbeh and Saif, Mehrdad and Palade, Vasile},
  journal   = {Sensors},
  volume    = {22},
  number    = {7},
  pages     = {2644},
  year      = {2022},
  doi       = {10.3390/s22072644},
  abstract  = {This paper proposes a resilient consensus control design for DC microgrids against false data injection (FDI) attacks. The control strategy is based on a distributed bank of sliding mode observers (SMOs) implemented at each agent level to estimate and mitigate the attack signals in the communication links. By using the estimated attack states, the cooperative secondary control is adjusted to restore the node voltages and load sharing accuracy despite cyber disruptions. Simulation results validate the robustness of the bank of observers under time-varying and constant FDI attacks.}
}

